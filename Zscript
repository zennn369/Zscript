local accum, listAccum = 0, 0
table.insert(connections, RunService.Heartbeat:Connect(function(dt)
	accum += dt
	listAccum += dt

	if accum >= CONFIG.UpdateRate then
		accum = 0
		updateESP()
	end

	if listAccum >= CONFIG.ListRate then
		listAccum = 0
		if main.Visible and currentTab == "Egg" then
			refreshEggList()
		end
	end
end))

