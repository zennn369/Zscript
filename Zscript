table.insert(connections, RunService.RenderStepped:Connect(function()
	if not settings.Fly then return end
	local root = getRoot()
	local bv, bg = flyObjs[1], flyObjs[2]
	local cam = workspace.CurrentCamera
	if not (root and bv and bg and bv.Parent and cam) then return end

	local mv = getMoveVector()
	local vert = 0
	if UserInputService:IsKeyDown(Enum.KeyCode.Space) or UserInputService:IsKeyDown(Enum.KeyCode.E) or mobileUp then
		vert += 1
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.Q) or mobileDown then
		vert -= 1
	end

	local dir = cam.CFrame.LookVector * -mv.Z + cam.CFrame.RightVector * mv.X + Vector3.new(0, vert, 0)
	bv.Velocity = dir * settings.FlySpeed

	local flat = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
	if flat.Magnitude > 0.01 then
		bg.CFrame = CFrame.lookAt(root.Position, root.Position + flat)
	end
end))

