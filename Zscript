-- MOVEMENT UPDATE
connect(RunService.Heartbeat, function()
    if not alive then return end

    local hum = getHumanoid()
    if state.speed and hum then
        hum.WalkSpeed = state.speedValue
    end

    flyPad.Visible = state.fly and UIS.TouchEnabled

    if state.fly then
        local root = getRoot()
        local cam = workspace.CurrentCamera

        if root and cam and flyVelocity and flyGyro
            and flyVelocity.Parent == root
            and flyGyro.Parent == root then

            local forward, right = 0, 0
            if UIS:IsKeyDown(Enum.KeyCode.W) then forward += 1 end
            if UIS:IsKeyDown(Enum.KeyCode.S) then forward -= 1 end
            if UIS:IsKeyDown(Enum.KeyCode.D) then right += 1 end
            if UIS:IsKeyDown(Enum.KeyCode.A) then right -= 1 end

            local vertical = 0
            if UIS:IsKeyDown(Enum.KeyCode.Space) or mobileUp then
                vertical += 1
            end
            if UIS:IsKeyDown(Enum.KeyCode.LeftControl)
                or UIS:IsKeyDown(Enum.KeyCode.Q) or mobileDown then
                vertical -= 1
            end

            local look = cam.CFrame.LookVector
            local flatLook = Vector3.new(look.X, 0, look.Z)
            local flatRight = Vector3.new(
                cam.CFrame.RightVector.X, 0,
                cam.CFrame.RightVector.Z
            )

            local direction = flatLook * forward
                + flatRight * right
                + Vector3.new(0, vertical, 0)

            if direction.Magnitude > 1 then
                direction = direction.Unit
            end

            flyVelocity.Velocity = direction * state.flySpeed

            if flatLook.Magnitude > 0.01 then
                flyGyro.CFrame = CFrame.lookAt(
                    root.Position, root.Position + flatLook.Unit
                )
            end
        end
    end
end)

connect(UIS.JumpRequest, function()
    if state.infJump then
        local hum = getHumanoid()
        if hum then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end)

-- Anti AFK helper: reports idle status only.
-- Roblox may restrict simulated input in some environments.
connect(player.Idled, function()
    if state.antiAFK then
        notify("Kamu sedang idle")
    end
end)

-- Respawn handling
connect(player.CharacterAdded, function(char)
    task.wait(0.3)
    if not alive then return end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        originalSpeed = hum.WalkSpeed
        if state.speed then hum.WalkSpeed = state.speedValue end
    end

    if state.fly then
        state.fly = false
        if flyVelocity then flyVelocity:Destroy(); flyVelocity = nil end
        if flyGyro then flyGyro:Destroy(); flyGyro = nil end
        notify("Fly dimatikan setelah respawn")
    end
end)

-- ESP discovery and update
local function tryAdd(inst)
    if alive and isEgg(inst) then
        addEgg(inst)
    end
end

for _, inst in ipairs(workspace:GetDescendants()) do
    tryAdd(inst)
end

connect(workspace.DescendantAdded, tryAdd)
connect(workspace.DescendantRemoving, removeEgg)

local elapsed = 0
connect(RunService.Heartbeat, function(dt)
    elapsed += dt
    if elapsed < CONFIG.UpdateRate then return end
    elapsed = 0

    local root = getRoot()
    for inst, data in pairs(tracked) do
        if not inst:IsDescendantOf(workspace) then
            removeEgg(inst)
        else
            local dist = root
                and (eggPosition(inst) - root.Position).Magnitude
                or math.huge
            local visible = state.esp and dist <= state.maxDistance

            data[1].Enabled = visible
            data[2].Enabled = visible

            local parts = {}
            if state.showName then
                table.insert(parts, inst.Name)
            end
            if state.showDist then
                table.insert(parts, string.format("%d studs", dist))
            end
            data[3].Text = table.concat(parts, "\n")
        end
    end

    if currentPage == "Egg" and main.Visible then
        refreshEggList()
    end
end)

-- Keyboard hide/show
connect(UIS.InputBegan, function(input, processed)
    if processed then return end
    if input.KeyCode == CONFIG.ToggleKey then
        main.Visible = not main.Visible
        mini.Visible = not main.Visible
    end
end)

