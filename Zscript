-- PlayerModule dimuat di background supaya script tidak tertahan saat start
local controls
task.spawn(function()
	local ok, result = pcall(function()
		local scripts = player:WaitForChild("PlayerScripts", 10)
		local module = scripts and scripts:WaitForChild("PlayerModule", 10)
		return module and require(module):GetControls()
	end)
	if ok and result and not destroyed then controls = result end
end)

local function getMoveVector()
	-- jangan gerak saat sedang mengetik di TextBox
	if UserInputService:GetFocusedTextBox() then return Vector3.zero end

	if controls then
		local ok, v = pcall(function() return controls:GetMoveVector() end)
		if ok and typeof(v) == "Vector3" then return v end
	end

	-- fallback keyboard
	local x, z = 0, 0
	if UserInputService:IsKeyDown(Enum.KeyCode.D) then x += 1 end
	if UserInputService:IsKeyDown(Enum.KeyCode.A) then x -= 1 end
	if UserInputService:IsKeyDown(Enum.KeyCode.S) then z += 1 end
	if UserInputService:IsKeyDown(Enum.KeyCode.W) then z -= 1 end
	return Vector3.new(x, 0, z)
end

local function stopFly()
	for _, o in pairs(flyObjs) do
		if o then o:Destroy() end
	end
	flyObjs = {}
	flyLV, flyAO = nil, nil

	local hum, root = getHumanoid(), getRoot()
	if hum then hum.PlatformStand = false end
	if root then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end
end

local function startFly()
	stopFly()
	local root, hum = getRoot(), getHumanoid()
	if not root or not hum or hum.Health <= 0 then return end

	-- LinearVelocity + AlignOrientation (pengganti BodyVelocity/BodyGyro yang deprecated)
	local att = create("Attachment", { Name = "UP_FlyAttachment", Parent = root })

	flyLV = create("LinearVelocity", {
		Attachment0 = att,
		RelativeTo = Enum.ActuatorRelativeTo.World,
		VelocityConstraintMode = Enum.VelocityConstraintMode.Vector,
		MaxForce = math.huge,
		VectorVelocity = Vector3.zero,
		Parent = root,
	})
	flyAO = create("AlignOrientation", {
		Attachment0 = att,
		Mode = Enum.OrientationAlignmentMode.OneAttachment,
		RigidityEnabled = false,
		MaxTorque = math.huge,
		Responsiveness = 60,
		CFrame = root.CFrame.Rotation,
		Parent = root,
	})

	hum.PlatformStand = true
	flyObjs = { att, flyLV, flyAO }
end

