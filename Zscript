local pages, tabButtons = {}, {}
local currentTab
local onTabShown = {}

local function selectTab(name)
	for n, p in pairs(pages) do
		p.Visible = (n == name)
		tween(tabButtons[n], {
			BackgroundColor3 = (n == name) and THEME.Accent or THEME.Side,
			TextColor3 = (n == name) and Color3.fromRGB(20, 20, 20) or THEME.SubText,
		})
	end
	currentTab = name
	if onTabShown[name] then onTabShown[name]() end
end

local function createPage(name, icon)
	local page = create("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
