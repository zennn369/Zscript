-- Daftar yang di-update "in place": baris TIDAK dihancurkan tiap refresh,
-- hanya teks & urutannya yang diperbarui, sehingga tombol TP selalu bisa diklik.
-- entries: { { key, left, right?, color? }, ... }
local function makeKeyedList(container, rowOpts, emptyText)
	local rows = {}

	local emptyLabel = create("TextLabel", {
		Text = emptyText,
		Font = Enum.Font.Gotham,
		TextSize = 12,
		TextColor3 = THEME.SubText,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 24),
		LayoutOrder = 0,
		Visible = false,
		Parent = container,
	})

	return function(entries)
		if destroyed then return end
		local seen = {}
		for i, e in ipairs(entries) do
			seen[e.key] = true
			local row = rows[e.key]
			if not row then
				row = makeRow(container, {
					dotColor = e.color,
					hasRight = rowOpts.hasRight,
					btnText = rowOpts.btnText,
					onClick = rowOpts.onClick,
				})
				rows[e.key] = row
			end
			row.data = e
			row.frame.LayoutOrder = i
			if row.left.Text ~= e.left then row.left.Text = e.left end
			if row.right then
				local r = e.right or ""
				if row.right.Text ~= r then row.right.Text = r end
			end
			if row.dot and e.color then row.dot.BackgroundColor3 = e.color end
		end
		for key, row in pairs(rows) do
			if not seen[key] then
				row.frame:Destroy()
				rows[key] = nil
			end
		end
		emptyLabel.Visible = (#entries == 0)
	end
end

