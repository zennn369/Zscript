local function refreshEggList()
	local origin = getOriginPosition()
	local entries = {}
	for inst, data in pairs(tracked) do
		table.insert(entries, {
			key = inst,
			inst = inst,
			name = inst.Name,
			dist = (getPosition(inst) - origin).Magnitude,
			color = data.color,
		})
	end
	table.sort(entries, function(a, b) return a.dist < b.dist end)

	eggCountLabel.Text = string.upper("Egg Panel (" .. #entries .. " ditemukan)")

	local shown = {}
	for i = 1, math.min(#entries, CONFIG.MaxListRows) do
		local e = entries[i]
		e.left = e.name
		e.right = math.floor(e.dist) .. " st"
		shown[i] = e
	end
	syncEggList(shown)
end
