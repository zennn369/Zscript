local function closeAll()
	if destroyed then return end
	destroyed = true

	settings.Fly = false
	mobileUp, mobileDown = false, false
	stopFly()
	setSpeedEnabled(false)

	for _, c in ipairs(connections) do
		c:Disconnect()
	end
	table.clear(connections)

	for inst in pairs(tracked) do removeEgg(inst) end
	table.clear(pending)

	espFolder:Destroy()
	gui:Destroy()

	if shared.UtilityPanelCleanup == closeAll then
		shared.UtilityPanelCleanup = nil
	end
end

