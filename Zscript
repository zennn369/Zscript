local originalSpeeds = setmetatable({}, { __mode = "k" })

table.insert(connections, RunService.Heartbeat:Connect(function()
	if not settings.SpeedEnabled then return end
	local hum = getHumanoid()
	if not hum then return end
	if originalSpeeds[hum] == nil then
		originalSpeeds[hum] = hum.WalkSpeed -- simpan kecepatan asli game
	end
	if hum.WalkSpeed ~= settings.Speed then
		hum.WalkSpeed = settings.Speed
	end
end))

local function setSpeedEnabled(v)
	settings.SpeedEnabled = v
	if not v then
		local hum = getHumanoid()
		if hum then
			hum.WalkSpeed = originalSpeeds[hum] or DEFAULT_SPEED
			originalSpeeds[hum] = nil
		end
	end
end

