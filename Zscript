		Parent = holder,
	})

	local valueLabel = create("TextLabel", {
		Text = tostring(default),
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextColor3 = THEME.Accent,
		TextXAlignment = Enum.TextXAlignment.Right,
		BackgroundTransparency = 1,
		Position = UDim2.new(0.6, 0, 0, 5),
		Size = UDim2.new(0.4, -12, 0, 16),
		Parent = holder,
	})

	local hit = create("TextButton", {
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 26),
		Size = UDim2.new(1, -24, 0, 18),
		Parent = holder,
	})
	local bar = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.new(1, 0, 0, 6),
		BackgroundColor3 = THEME.Off,
		Parent = hit,
	}, { corner(3) })
	local fill = create("Frame", {
		Size = UDim2.fromScale((default - min) / (max - min), 1),
		BackgroundColor3 = THEME.Accent,
		Parent = bar,
	}, { corner(3) })

	local dragging = false
	local function setDragging(v)
		dragging = v
		-- cegah halaman ikut ter-scroll saat slider digeser (penting di HP)
		if parent:IsA("ScrollingFrame") then
			parent.ScrollingEnabled = not v
		end
	end

	local function setFromX(x)
		local width = bar.AbsoluteSize.X
		if width <= 0 then return end
		local alpha = math.clamp((x - bar.AbsolutePosition.X) / width, 0, 1)
		local value = math.floor(min + (max - min) * alpha + 0.5)
		fill.Size = UDim2.fromScale(alpha, 1)
		valueLabel.Text = tostring(value)
		callback(value)
	end

	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			setDragging(true)
			setFromX(input.Position.X)
		end
	end)
	table.insert(connections, UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			if dragging then setDragging(false) end
		end
	end))
	table.insert(connections, UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			setFromX(input.Position.X)
		end
	end))
end

