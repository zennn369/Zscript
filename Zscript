-- Daftar yang di-update "in place": baris TIDAK dihancurkan tiap refresh,
-- hanya teks & urutannya yang diperbarui, sehingga tombol TP selalu bisa diklik.
local function makeKeyedList(container, rowOpts, emptyText)
	local rows = {}

	local emptyLabel = create("TextLabel", {
		Text = emptyText,
		Font = Enum.Font.Gotham,
		TextSize = 12,
		TextColor3 = THEME.SubText,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 24),
		LayoutOrder = 0,
		Visible = false,
		Parent = container,
	})

	return function(entries)
		local seen = {}
		for i, e in ipairs(entries) do
			seen[e.key] = true
			local row = rows[e.key]
			if not row then
				local opts = {
					dotColor = e.color,
					hasRight = rowOpts.hasRight,
					btnText = rowOpts.btnText,
					onClick = rowOpts.onClick,
				}
				row = makeRow(container, opts)
				rows[e.key] = row
			end
			row.data = e
			row.frame.LayoutOrder = i
			row.left.Text = e.left
			if row.right then row.right.Text = e.right or "" end
			if row.dot and e.color then row.dot.BackgroundColor3 = e.color end
		end
		for key, row in pairs(rows) do
			if not seen[key] then
				row.frame:Destroy()
				rows[key] = nil
			end
		end
		emptyLabel.Visible = (#entries == 0)
	end
end

