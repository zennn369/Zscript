local function setFly(v)
	settings.Fly = v
	mobileUp, mobileDown = false, false
	flyPad.Visible = v and UserInputService.TouchEnabled
	if v then startFly() else stopFly() end
end

local function updateFly()
	if not settings.Fly then return end

	local root, hum = getRoot(), getHumanoid()
	local cam = workspace.CurrentCamera
	if not (root and hum and cam) then return end
	if not (flyLV and flyLV.Parent and flyAO and flyAO.Parent) then return end

	if hum.Health <= 0 then
		flyLV.VectorVelocity = Vector3.zero
		return
	end
	hum.PlatformStand = true

	local mv = getMoveVector()
	local vert = 0
	if not UserInputService:GetFocusedTextBox() then
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) or UserInputService:IsKeyDown(Enum.KeyCode.E) then
			vert += 1
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.Q) then
			vert -= 1
		end
	end
	if mobileUp then vert += 1 end
	if mobileDown then vert -= 1 end
	vert = math.clamp(vert, -1, 1)

	local cf = cam.CFrame
	local dir = cf.LookVector * -mv.Z + cf.RightVector * mv.X + Vector3.new(0, vert, 0)
	if dir.Magnitude > 1 then dir = dir.Unit end -- diagonal tidak lebih cepat
	flyLV.VectorVelocity = dir * settings.FlySpeed

	local flat = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
	if flat.Magnitude > 0.01 then
		flyAO.CFrame = CFrame.lookAt(Vector3.zero, flat)
	end
end

