local function clampMini()
	local vs = gui.AbsoluteSize
	if vs.X <= 0 or vs.Y <= 0 then return end
	local x = math.clamp(miniBtn.Position.X.Offset, 0, math.max(0, vs.X - MINI_W))
	local y = math.clamp(miniBtn.Position.Y.Offset, 0, math.max(0, vs.Y - MINI_H))
	miniBtn.Position = UDim2.fromOffset(x, y)
end

-- Ukuran & posisi window menyesuaikan layar (penting untuk HP / rotasi layar)
local placed = false
local function fitWindow()
	local vs = gui.AbsoluteSize
	if vs.X <= 0 or vs.Y <= 0 then return end

	local w = math.clamp(vs.X - 16, math.min(320, vs.X), WIN_W)
	local h = math.clamp(vs.Y - 16, math.min(240, vs.Y), WIN_H)
	main.Size = UDim2.fromOffset(w, h)

	local x, y
	if not placed then
		placed = true
		x, y = 24, (vs.Y - h) / 2
	else
		x, y = main.Position.X.Offset, main.Position.Y.Offset
	end
	x = math.clamp(x, 0, math.max(0, vs.X - w))
	y = math.clamp(y, 0, math.max(0, vs.Y - h))
	main.Position = UDim2.fromOffset(x, y)

	clampMini()
end
