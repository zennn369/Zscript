local function setPanelVisible(visible)
	if not visible then
		-- tombol mini muncul di posisi window (atau posisi terakhir yang digeser pemain)
		if not miniMoved then
			miniBtn.Position = UDim2.fromOffset(main.Position.X.Offset, main.Position.Y.Offset)
		end
		clampMini() -- pastikan tombol mini SELALU terlihat di layar
	end
	main.Visible = visible
	miniBtn.Visible = not visible
end

hideBtn.MouseButton1Click:Connect(function() setPanelVisible(false) end)

-- Tombol mini: tap = buka panel, geser = pindahkan
do
	local dragStart, startPos, moved = Vector2.zero, nil, false
	makeDraggable(miniBtn, {
		began = function(pos)
			dragStart, startPos, moved = pos, miniBtn.Position, false
		end,
		moved = function(pos)
			local delta = pos - dragStart
			if not moved and delta.Magnitude < 6 then return end
			moved, miniMoved = true, true
			miniBtn.Position = UDim2.fromOffset(
				startPos.X.Offset + delta.X,
				startPos.Y.Offset + delta.Y
			)
			clampMini()
		end,
		ended = function()
			if not moved then setPanelVisible(true) end
		end,
	})
end

bind(UserInputService.InputBegan, function(input, processed)
	if processed then return end
	if input.KeyCode == CONFIG.ToggleKey then
		setPanelVisible(not main.Visible)
	end
end)

