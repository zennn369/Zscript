local function refreshEggList()
	clearContainer(eggList)

	local origin = getOriginPosition()
	local entries = {}
	for inst in pairs(tracked) do
		table.insert(entries, {
			inst = inst,
			name = inst.Name,
			dist = (getPosition(inst) - origin).Magnitude,
			color = tracked[inst].color,
		})
	end
	table.sort(entries, function(a, b) return a.dist < b.dist end)

	eggCountLabel.Text = string.upper("Egg Panel (" .. #entries .. " ditemukan)")

	if #entries == 0 then
		makeEmptyLabel(eggList, "Belum ada egg terdeteksi")
		return
	end

	for i = 1, math.min(#entries, 40) do
		local e = entries[i]
		makeRow(eggList, i, e.name, string.format("%d st", e.dist), e.color, "TP", function()
			if e.inst:IsDescendantOf(workspace) and teleportTo(getPosition(e.inst)) then
				notify("Teleport ke " .. e.name)
			end
		end)
	end
end
