local accum, listAccum = 0, 0
table.insert(connections, RunService.Heartbeat:Connect(function(dt)
	accum += dt
	listAccum += dt
	if accum >= CONFIG.UpdateRate then
		accum = 0
		updateESP()
	end
	if listAccum >= 1 and main.Visible then
		listAccum = 0
		if currentTab == "Egg" then
			refreshEggList()
		elseif currentTab == "Teleport" then
			refreshPlayerList()
		end
	end
end))

