-- Sambungkan event & catat supaya otomatis diputus saat ditutup
local function bind(signal, fn)
	local c = signal:Connect(fn)
	table.insert(connections, c)
	return c
end

local function create(class, props, children)
	local inst = Instance.new(class)
	if inst:IsA("GuiObject") then
		inst.BorderSizePixel = 0 -- default Roblox = 1 (garis hitam), kita matikan
	end
	local parent
	for k, v in pairs(props or {}) do
		if k == "Parent" then
			parent = v -- diset paling akhir supaya lebih efisien
		else
			inst[k] = v
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	inst.Parent = parent
	return inst
end

local function corner(r)
	return create("UICorner", { CornerRadius = UDim.new(0, r) })
end

local function stroke(color, thickness)
	return create("UIStroke", {
		Color = color or THEME.Stroke,
		Thickness = thickness or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

local function padding(left, right, top, bottom)
	return create("UIPadding", {
		PaddingLeft   = UDim.new(0, left or 0),
		PaddingRight  = UDim.new(0, right or 0),
		PaddingTop    = UDim.new(0, top or 0),
		PaddingBottom = UDim.new(0, bottom or 0),
	})
end

local function listLayout(gap)
	return create("UIListLayout", {
		Padding = UDim.new(0, gap),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

local function tween(obj, props, t)
	if not obj or not obj.Parent then return end
	TweenService:Create(obj, TweenInfo.new(t or 0.15, Enum.EasingStyle.Quad), props):Play()
end

local orderCounter = 0
local function nextOrder()
	orderCounter += 1
	return orderCounter
end

local function getHumanoid()
	local c = player.Character
	return c and c:FindFirstChildOfClass("Humanoid")
end

local function getRoot()
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function colorFromName(name)
	local hash = 0
	for i = 1, #name do
		hash = (hash * 31 + string.byte(name, i)) % 360
	end
	return Color3.fromHSV(hash / 360, 0.65, 1)
end

-- yOffset: jarak di atas titik tujuan (supaya tidak menembus tanah / objek)
local function teleportTo(pos, yOffset)
	local char, root = player.Character, getRoot()
	if not (char and root) then return false end
	char:PivotTo(CFrame.new(pos + Vector3.new(0, yOffset or 0, 0)) * root.CFrame.Rotation)
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	return true
end

local function isPointerPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

-- Drag generik (mouse & touch, aman untuk multi-touch).
-- cb.began(pos) / cb.moved(pos) / cb.ended() ; pos = Vector2 posisi layar
local function makeDraggable(handle, cb)
	local active

	handle.InputBegan:Connect(function(input)
		if active or not isPointerPress(input) then return end
		active = input
		if cb.began then cb.began(Vector2.new(input.Position.X, input.Position.Y)) end

		local conn
		conn = input.Changed:Connect(function()
			if input.UserInputState ~= Enum.UserInputState.End then return end
			conn:Disconnect()
			if active == input then
				active = nil
				if cb.ended then cb.ended() end
			end
		end)
	end)

	bind(UserInputService.InputChanged, function(input)
		if not active then return end
		if input == active or input.UserInputType == Enum.UserInputType.MouseMovement then
			cb.moved(Vector2.new(input.Position.X, input.Position.Y))
		end
	end)
end

-- Tombol tahan (untuk tombol naik/turun di HP)
local function holdButton(btn, onChange)
	btn.InputBegan:Connect(function(input)
		if not isPointerPress(input) then return end
		onChange(true)
		local conn
		conn = input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				conn:Disconnect()
				onChange(false)
			end
		end)
	end)
end

