-- Sambungkan event DULU, baru scan (supaya tidak ada egg yang terlewat saat scan berjalan)
bind(workspace.DescendantAdded, tryAdd)
bind(workspace.DescendantRemoving, removeEgg)

task.spawn(function()
	local count = 0
	for _, d in ipairs(workspace:GetDescendants()) do
		if destroyed then return end
		tryAdd(d)
		count += 1
		if count % 3000 == 0 then task.wait() end -- jangan bikin game freeze di map besar
	end
end)

do
	local espAccum, listAccum, pendingAccum = 0, 0, 0
	bind(RunService.Heartbeat, function(dt)
		updateSpeed()

		espAccum += dt
		listAccum += dt
		pendingAccum += dt

		if espAccum >= CONFIG.UpdateRate then
			espAccum = 0
			updateESP()
		end

		if pendingAccum >= CONFIG.PendingRate then
			pendingAccum = 0
			processPending()
		end

		if listAccum >= CONFIG.ListRate then
			listAccum = 0
			if main.Visible and currentTab == "Egg" then
				refreshEggList()
			end
		end
	end)
end

