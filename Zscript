local flyObjs = {}
local mobileUp, mobileDown = false, false

local controls
pcall(function()
	controls = require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 3)):GetControls()
end)

local function getMoveVector()
	if controls then
		local ok, v = pcall(function() return controls:GetMoveVector() end)
		if ok and v then return v end
	end
	local x, z = 0, 0
	if UserInputService:IsKeyDown(Enum.KeyCode.D) then x += 1 end
	if UserInputService:IsKeyDown(Enum.KeyCode.A) then x -= 1 end
	if UserInputService:IsKeyDown(Enum.KeyCode.S) then z += 1 end
	if UserInputService:IsKeyDown(Enum.KeyCode.W) then z -= 1 end
	return Vector3.new(x, 0, z)
end

local function stopFly()
	for _, o in pairs(flyObjs) do o:Destroy() end
	flyObjs = {}
	local hum = getHumanoid()
	if hum then hum.PlatformStand = false end
end

local function startFly()
	stopFly()
	local root, hum = getRoot(), getHumanoid()
	if not root or not hum then return end

	local bv = create("BodyVelocity", {
		MaxForce = Vector3.new(1e9, 1e9, 1e9),
		Velocity = Vector3.zero,
		Parent = root,
	})
	local bg = create("BodyGyro", {
		MaxTorque = Vector3.new(1e9, 1e9, 1e9),
		P = 9e4,
		CFrame = root.CFrame,
		Parent = root,
	})
	hum.PlatformStand = true
	flyObjs = { bv, bg }
end

