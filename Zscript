local function isEgg(inst)
    if not (inst:IsA("Model") or inst:IsA("BasePart")) then
        return false
    end
    local name = string.lower(inst.Name)
    for _, keyword in ipairs(CONFIG.EggKeywords) do
        if string.find(name, keyword, 1, true) then
            return true
        end
    end
    return false
end

local function eggPosition(inst)
    if inst:IsA("Model") then
        return inst:GetPivot().Position
    end
    return inst.Position
end

local function removeEgg(inst)
    local data = tracked[inst]
    if not data then return end
    for _, obj in ipairs(data) do
        if obj and obj.Parent then obj:Destroy() end
    end
    tracked[inst] = nil
end

local function addEgg(inst)
    if tracked[inst] or not isEgg(inst) then return end
    if player.Character and inst:IsDescendantOf(player.Character) then
        return
    end

    local part
    if inst:IsA("BasePart") then
        part = inst
    else
        part = inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
    end
    if not part then return end

    local highlight = make("Highlight", {
        Adornee = inst,
        FillColor = C.accent,
        OutlineColor = Color3.new(1, 1, 1),
        FillTransparency = 0.65,
        Enabled = false
    }, gui)

    local billboard = make("BillboardGui", {
        Adornee = part,
        Size = UDim2.fromOffset(170, 38),
        StudsOffset = Vector3.new(0, 2.5, 0),
        AlwaysOnTop = true,
        Enabled = false
    }, gui)

    local label = make("TextLabel", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        TextColor3 = C.accent,
        TextStrokeTransparency = 0.3,
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        TextWrapped = true,
        Text = inst.Name
    }, billboard)

    tracked[inst] = {highlight, billboard, label}
end

local function clearEggList()
    for _, child in ipairs(eggList:GetChildren()) do
        if child:IsA("TextButton") or child:IsA("TextLabel") then
            child:Destroy()
        end
    end
end

local function refreshEggList()
    clearEggList()
    local root = getRoot()
    local entries = {}

    for inst in pairs(tracked) do
        if inst:IsDescendantOf(workspace) then
            local dist = root and (eggPosition(inst) - root.Position).Magnitude or 0
            table.insert(entries, {inst = inst, dist = dist})
        end
    end

    table.sort(entries, function(a, b)
        return a.dist < b.dist
    end)

    if #entries == 0 then
        make("TextLabel", {
            Size = UDim2.new(1, 0, 0, 26),
            BackgroundTransparency = 1,
            Text = "Belum ada telur terdeteksi",
            TextColor3 = C.sub,
            Font = Enum.Font.Gotham,
            TextSize = 11
        }, eggList)
        return
    end

    for i = 1, math.min(#entries, 25) do
        local entry = entries[i]
        local inst = entry.inst

        local b = make("TextButton", {
            Size = UDim2.new(1, 0, 0, 32),
            BackgroundColor3 = C.card,
            Text = string.format("%s  |  %d studs", inst.Name, entry.dist),
            TextColor3 = C.text,
            Font = Enum.Font.GothamMedium,
            TextSize = 10,
            TextTruncate = Enum.TextTruncate.AtEnd,
            LayoutOrder = i
        }, eggList)
        round(b, 7)

        connect(b.MouseButton1Click, function()
            if inst.Parent and inst:IsDescendantOf(workspace) then
                teleport(eggPosition(inst))
            else
                notify("Telur sudah tidak tersedia")
            end
        end)
    end
end

