local tracked = {} -- [inst] = { highlight, billboard, label, color, part, dist }
local pending = {} -- [inst] = batas waktu (os.clock) menunggu part egg ter-load
local espActive = true

-- normalisasi keyword: huruf kecil + buang spasi di pinggir
local keywords = {}
for _, kw in ipairs(CONFIG.Keywords) do
	local k = string.lower(kw):match("^%s*(.-)%s*$")
	if k and k ~= "" then table.insert(keywords, k) end
end

-- Keyword harus diawali batas kata: "common egg" cocok dengan "Common Egg"
-- tapi TIDAK cocok dengan "Uncommon Egg".
local function containsKeyword(lowered, kw)
	local init = 1
	while true do
		local s = string.find(lowered, kw, init, true)
		if not s then return false end
		if s == 1 or not string.match(string.sub(lowered, s - 1, s - 1), "%w") then
			return true
		end
		init = s + 1
	end
end

-- cache hasil per nama (nama objek sangat sering berulang di workspace)
local nameCache, nameCacheSize = {}, 0
local function matchesKeyword(name)
	local cached = nameCache[name]
	if cached ~= nil then return cached end

	local lowered = string.lower(name)
	local result = false
	for _, kw in ipairs(keywords) do
		if containsKeyword(lowered, kw) then
			result = true
			break
		end
	end

	if nameCacheSize >= 5000 then
		nameCache, nameCacheSize = {}, 0
	end
	nameCache[name] = result
	nameCacheSize += 1
	return result
end

-- true bila objek ada di dalam karakter pemain mana pun (egg yang sedang dipegang),
-- di dalam kamera (preview), atau di dalam objek egg lain (bagian dari egg induk)
local function isExcluded(inst)
	local p = inst.Parent
	while p and p ~= workspace do
		if p:IsA("Camera") then return true end
		if p:IsA("Model") and Players:GetPlayerFromCharacter(p) then return true end
		if (p:IsA("Model") or p:IsA("BasePart")) and matchesKeyword(p.Name) then return true end
		p = p.Parent
	end
	return false
end

local function isEgg(inst)
	if not (inst:IsA("Model") or inst:IsA("BasePart")) then return false end
	if not matchesKeyword(inst.Name) then return false end
	if inst:IsA("Model") and Players:GetPlayerFromCharacter(inst) then return false end
	return not isExcluded(inst)
end

local function getAdorneePart(inst)
	if inst:IsA("BasePart") then return inst end
	return inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
end

local function getPosition(inst)
	if inst:IsA("Model") then return inst:GetPivot().Position end
	return inst.Position
end

local function removeEgg(inst)
	pending[inst] = nil
	local data = tracked[inst]
	if not data then return end
	if data.highlight then data.highlight:Destroy() end
	if data.billboard then data.billboard:Destroy() end
	tracked[inst] = nil
end

-- return true bila egg sudah terdaftar
local function addEgg(inst)
	if tracked[inst] then return true end
	if destroyed then return false end
	local part = getAdorneePart(inst)
	if not part then return false end

	local color = colorFromName(inst.Name)

	local highlight = create("Highlight", {
		Adornee = inst,
		FillColor = color,
		OutlineColor = Color3.new(1, 1, 1),
		FillTransparency = 0.6,
		DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
		Enabled = false, -- diatur oleh updateESP
		Parent = espFolder,
	})

	local label = create("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextColor3 = color,
		TextStrokeTransparency = 0.4,
		Text = inst.Name,
	})

	local billboard = create("BillboardGui", {
		Adornee = part,
		Size = UDim2.fromOffset(180, 40),
		StudsOffset = Vector3.new(0, 2.5, 0),
		AlwaysOnTop = true,
		ResetOnSpawn = false,
		Active = false,
		Enabled = false, -- diatur oleh updateESP
		Parent = espFolder,
	}, { label })

	tracked[inst] = {
		highlight = highlight,
		billboard = billboard,
		label = label,
		color = color,
		part = part,
		dist = 0,
	}
	return true
end

local function tryAdd(inst)
	if destroyed or tracked[inst] or pending[inst] then return end
	if not isEgg(inst) then return end
	if not addEgg(inst) then
		-- Model egg sudah muncul tapi part-nya belum ter-load (replikasi / streaming):
		-- dicek ulang berkala oleh processPending supaya tidak terlewat.
		pending[inst] = os.clock() + CONFIG.PendingTimeout
	end
end

local function processPending()
	local now = os.clock()
	for inst, deadline in pairs(pending) do
		if now > deadline or not inst:IsDescendantOf(workspace) then
			pending[inst] = nil
		elseif addEgg(inst) then
			pending[inst] = nil
		end
	end
end

local function getOriginPosition()
	local root = getRoot()
	if root then return root.Position end
	local cam = workspace.CurrentCamera
	return cam and cam.CFrame.Position or Vector3.zero
end

local function updateESP()
	-- ESP mati: matikan semua visual sekali saja, lalu tidak perlu hitung apa-apa
	if not settings.ESP then
		if espActive then
			espActive = false
			for _, data in pairs(tracked) do
				data.billboard.Enabled = false
				data.highlight.Enabled = false
			end
		end
		return
	end
	espActive = true

	local origin = getOriginPosition()
	local candidates = {}

	for inst, data in pairs(tracked) do
		if not inst:IsDescendantOf(workspace) then
			removeEgg(inst)
		else
			-- pastikan part tempat label menempel masih valid
			local part = data.part
			if not (part and part.Parent and (part == inst or part:IsDescendantOf(inst))) then
				part = getAdorneePart(inst)
				data.part = part
				data.billboard.Adornee = part
			end

			if not part then
				data.billboard.Enabled = false
				data.highlight.Enabled = false
			else
				local dist = (getPosition(inst) - origin).Magnitude
				data.dist = dist
				local visible = dist <= settings.MaxDistance
				data.billboard.Enabled = visible

				if visible then
					local text = ""
					if settings.ShowName then text = inst.Name end
					if settings.ShowDist then
						local d = string.format("[%d studs]", math.floor(dist))
						text = (text ~= "") and (text .. "\n" .. d) or d
					end
					if data.label.Text ~= text then data.label.Text = text end
					table.insert(candidates, data)
				else
					data.highlight.Enabled = false
				end
			end
		end
	end

	-- Roblox membatasi jumlah Highlight yang tampil, jadi hanya yang terdekat yang diaktifkan
	local limit = CONFIG.MaxHighlights
	if settings.Highlight and #candidates > limit then
		table.sort(candidates, function(a, b) return a.dist < b.dist end)
	end
	for i, data in ipairs(candidates) do
		data.highlight.Enabled = settings.Highlight and i <= limit
	end
end

