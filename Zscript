local function matchesKeyword(name)
	name = string.lower(name)
	for _, kw in ipairs(CONFIG.Keywords) do
		if string.find(name, kw, 1, true) then return true end
	end
	return false
end

local function isEgg(inst)
	if not (inst:IsA("Model") or inst:IsA("BasePart")) then return false end
	if not matchesKeyword(inst.Name) then return false end

	local char = player.Character
	if char and inst:IsDescendantOf(char) then return false end

	local p = inst.Parent
	while p and p ~= workspace do
		if p:IsA("Model") and matchesKeyword(p.Name) then return false end
		p = p.Parent
	end
	return true
end

local function getAdorneePart(inst)
	if inst:IsA("BasePart") then return inst end
	return inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
end

local function getPosition(inst)
	if inst:IsA("Model") then return inst:GetPivot().Position end
	return inst.Position
end

local function removeEgg(inst)
	local data = tracked[inst]
	if not data then return end
	if data.highlight then data.highlight:Destroy() end
	if data.billboard then data.billboard:Destroy() end
	tracked[inst] = nil
end

local function addEgg(inst)
	if tracked[inst] or destroyed then return end
	local part = getAdorneePart(inst)
	if not part then return end

	local color = colorFromName(inst.Name)

	local highlight = create("Highlight", {
		Adornee = inst,
		FillColor = color,
		OutlineColor = Color3.new(1, 1, 1),
		FillTransparency = 0.6,
		DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
		Parent = espFolder,
	})

	local label = create("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		TextColor3 = color,
		TextStrokeTransparency = 0.4,
		Text = inst.Name,
	})

	local billboard = create("BillboardGui", {
		Adornee = part,
		Size = UDim2.fromOffset(160, 36),
		StudsOffset = Vector3.new(0, 2.5, 0),
		AlwaysOnTop = true,
		ResetOnSpawn = false,
		Parent = espFolder,
	}, { label })

	tracked[inst] = { highlight = highlight, billboard = billboard, label = label, color = color }
end

local function tryAdd(inst)
	if isEgg(inst) then addEgg(inst) end
end

local function getOriginPosition()
	local root = getRoot()
	if root then return root.Position end
	local cam = workspace.CurrentCamera
	return cam and cam.CFrame.Position or Vector3.zero
end

local function updateESP()
	local origin = getOriginPosition()
	for inst, data in pairs(tracked) do
		if not inst:IsDescendantOf(workspace) then
			removeEgg(inst)
		else
			local dist = (getPosition(inst) - origin).Magnitude
			local visible = settings.ESP and dist <= settings.MaxDistance

			data.highlight.Enabled = visible and settings.Highlight
			data.billboard.Enabled = visible

			if visible then
				local text = ""
				if settings.ShowName then text = inst.Name end
				if settings.ShowDist then
					text = text .. (text ~= "" and "\n" or "") .. string.format("[%d studs]", dist)
				end
				data.label.Text = text
			end
		end
	end
end

